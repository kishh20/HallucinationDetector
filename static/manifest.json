{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "Hallucination Detector AI",
  "short_name": "Hallucination",
  "description": "Real-time AI hallucination detection, web-grounded evidence verification, and multi-source fact checking.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#090a0f",
  "theme_color": "#10121a",
  "categories": ["utilities", "productivity", "education", "news"],
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/static/screenshots/ui_main_dashboard.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Fact verification and hallucination detection dashboard"
    },
    {
      "src": "/static/screenshots/ui_mobile_pwa.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile chat interface with inline claim verdicts"
    }
  ],
  "shortcuts": [
    {
      "name": "New Verification",
      "short_name": "New Check",
      "description": "Start a fresh claim verification thread",
      "url": "/?action=new",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Admin Command Center",
      "short_name": "Admin",
      "description": "Open administrative controls and platform monitoring",
      "url": "/admin",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
